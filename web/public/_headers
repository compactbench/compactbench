# Headers for static pages and files (Workers static assets). These don't reach responses
# the Worker generates (sign-in, submissions, MCP); worker/security.ts covers those.
# Turnstile (optional bot check on /submit) is the only third-party origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Build output with content hashes in the name never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# Open data: readable from any origin, cached briefly.
/api/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Text for AI agents: UTF-8 (the pages use em dashes and ≥), readable from any origin.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# One page per ranked run: useful to its submitter, not to search engines.
/status
  X-Robots-Tag: noindex
