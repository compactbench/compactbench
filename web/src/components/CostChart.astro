---
// Score against what the method spent: model tokens per case, log scale.
// Methods that make no model calls sit at the left edge.
import { frontier, hoverPlacement, placeLabels, type Bounds } from "../lib/chart-labels";
import { pct, slugOf, type Row } from "../lib/data";

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
const points = rows.map((r) => ({
  row: r,
  tokens: r.method_tokens && r.cases ? r.method_tokens / r.cases : 0,
}));
const paid = points.filter((p) => p.tokens > 0).map((p) => p.tokens);
const lo = paid.length ? Math.log10(Math.min(...paid)) - 0.2 : 3;
const hi = paid.length ? Math.log10(Math.max(...paid)) + 0.2 : 6;
const w = 640;
const h = 300;
const pad = { l: 44, r: 20, t: 16, b: 40 };
const x = (t: number) =>
  t <= 0
    ? pad.l + 6
    : pad.l + 30 + ((Math.log10(t) - lo) / Math.max(hi - lo, 0.1)) * (w - pad.l - pad.r - 40);
const y = (v: number) => pad.t + (1 - v) * (h - pad.t - pad.b);
const fmt = (t: number) => (t >= 1e6 ? `${(t / 1e6).toFixed(1)}M` : `${Math.round(t / 1000)}k`);
// Name the dots that matter (the top three ranked, then the best value for the cost, then
// baselines) where a name fits without covering another; the rest show their name on hover.
const best = frontier(points.map((p) => ({ cost: p.tokens, score: p.row.score })));
const priority = (row: Row, i: number) =>
  (row.rank !== null && row.rank <= 3
    ? row.rank
    : best[i]
      ? 10
      : row.row_kind === "baseline"
        ? 20
        : 30) +
  (1 - row.score);
const bounds: Bounds = { left: pad.l + 2, right: w - 4, top: 2, bottom: h - pad.b + 10 };
const spots = points.map(({ row, tokens }, i) => ({
  x: x(tokens),
  y: y(row.score),
  text: row.method_name,
  priority: priority(row, i),
}));
const placements = placeLabels(spots, bounds);
// Named dots first, so a hover name (drawn later) sits on top of the printed ones.
const drawn = points
  .map((point, i) => ({ ...point, spot: spots[i], label: placements[i] ?? hoverPlacement(spots[i], bounds), hover: !placements[i] }))
  .sort((a, b) => Number(a.hover) - Number(b.hover));
const unnamed = drawn.some((d) => d.hover);
const kinds = (["submission", "baseline", "control"] as const).filter((k) => rows.some((r) => r.row_kind === k));
const kindName = { submission: "Ranked", baseline: "Baseline", control: "Control" } as const;
// 1-2-5 ticks inside the plotted range, so a range under one decade still gets a scale.
const ticks = paid.length
  ? Array.from({ length: Math.ceil(hi) - Math.floor(lo) + 1 }, (_, i) => Math.floor(lo) + i)
      .flatMap((k) => [1, 2, 5].map((m) => m * 10 ** k))
      .filter((t) => Math.log10(t) >= lo - 1e-9 && Math.log10(t) <= hi + 1e-9)
  : [];
---

<figure class="chart card">
  <figcaption>
    <h2>Score vs. cost</h2>
    <p class="muted">
      Model tokens the method spent per case (log scale). Up and to the left is better.{
        unnamed && " Hover a dot for its name."
      }
    </p>
    <ul class="legend">
      {kinds.map((k) => <li><span class={`key ${k}`} />{kindName[k]}</li>)}
    </ul>
  </figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Score against model tokens spent per case">
    {
      [0, 0.25, 0.5, 0.75, 1].map((t) => (
        <g>
          <line x1={pad.l} x2={w - pad.r} y1={y(t)} y2={y(t)} class="grid" />
          <text x={pad.l - 8} y={y(t) + 4} class="tick" text-anchor="end">{t * 100}</text>
        </g>
      ))
    }
    {ticks.map((t) => <text x={x(t)} y={h - 14} class="tick" text-anchor="middle">{fmt(t)}</text>)}
    <text x={pad.l + 6} y={h - 14} class="tick">free</text>
    {
      drawn.map(({ row, tokens, spot, label, hover }) => (
        <a href={`/methods/${slugOf(row)}`}>
          <circle cx={spot.x} cy={spot.y} r="6" class={`pt ${row.row_kind}`}>
            <title>{`${row.method_name}: ${pct(row.score)} at ${tokens ? fmt(tokens) : "no"} tokens per case`}</title>
          </circle>
          <text x={label.x} y={label.y} text-anchor={label.anchor} class:list={["label", { hover }]}>
            {row.method_name}
          </text>
        </a>
      ))
    }
  </svg>
</figure>

<style>
  .chart {
    margin: 24px 0 0;
  }
  figcaption h2 {
    font-size: 1.1rem;
    margin-bottom: 0.2em;
  }
  figcaption p {
    font-size: 0.85rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .grid {
    stroke: var(--border);
  }
  .tick {
    fill: var(--muted);
    font: 11px var(--mono);
  }
  .label {
    fill: var(--text);
    font: 11px var(--font);
    /* An outline in the card's colour keeps a name legible over grid lines. */
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .label.hover {
    opacity: 0;
    transition: opacity 0.12s;
    pointer-events: none;
  }
  a:hover .label.hover,
  a:focus-visible .label.hover {
    opacity: 1;
  }
  a:hover .pt,
  a:focus-visible .pt {
    stroke: var(--cyan);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .key {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--blue);
  }
  .key.submission {
    background: var(--violet);
  }
  .key.control {
    background: var(--muted);
  }
  .pt {
    fill: var(--blue);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .pt.submission {
    fill: var(--violet);
  }
  .pt.control {
    fill: var(--muted);
  }
</style>
