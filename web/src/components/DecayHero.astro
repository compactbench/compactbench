---
// Decorative only: two curves suggesting what repeated compaction does to what an
// agent remembers. No axes or numbers — real numbers live on the leaderboard.
---

<figure class="decay" aria-hidden="true">
  <svg viewBox="0 0 600 260" preserveAspectRatio="none">
    <defs>
      <linearGradient id="decay-line" x1="0" x2="1">
        <stop offset="0" stop-color="#22D3EE" />
        <stop offset="0.5" stop-color="#3B82F6" />
        <stop offset="1" stop-color="#8B5CF6" />
      </linearGradient>
      <linearGradient id="decay-fill" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#3B82F6" stop-opacity="0.22" />
        <stop offset="1" stop-color="#3B82F6" stop-opacity="0" />
      </linearGradient>
    </defs>
    {
      [52, 104, 156, 208].map((y) => (
        <line x1="0" x2="600" y1={y} y2={y} class="rule" />
      ))
    }
    {
      [120, 240, 360, 480].map((x) => (
        <line x1={x} x2={x} y1="0" y2="260" class="tick" />
      ))
    }
    <path
      class="kept"
      d="M0,40 C120,42 240,46 360,50 S520,56 600,58"
      fill="none"
      stroke="#273049"
      stroke-width="2"
      stroke-dasharray="6 8"></path>
    <path
      class="area"
      d="M0,40 C90,48 140,84 240,118 S420,176 600,206 L600,260 L0,260 Z"
      fill="url(#decay-fill)"></path>
    <path
      class="line"
      d="M0,40 C90,48 140,84 240,118 S420,176 600,206"
      fill="none"
      stroke="url(#decay-line)"
      stroke-width="3.5"
      stroke-linecap="round"></path>
    {
      [
        [0, 40],
        [120, 66],
        [240, 118],
        [360, 152],
        [480, 182],
      ].map(([x, y], i) => <circle cx={x} cy={y} r="5" class="dot" style={`--i:${i}`} />)
    }
  </svg>
  <figcaption class="mono">compaction 1 → 2 → 3 → 4 → 5</figcaption>
</figure>

<style>
  .decay {
    margin: 0;
    padding: 18px 18px 10px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: linear-gradient(180deg, rgb(11 14 23 / 0.9), rgb(5 6 11 / 0.6));
    box-shadow:
      0 0 0 1px rgb(59 130 246 / 0.06),
      0 30px 80px rgb(59 130 246 / 0.12);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 260;
  }
  .rule {
    stroke: #1a2133;
    stroke-width: 1;
  }
  .tick {
    stroke: #121828;
    stroke-width: 1;
  }
  .line {
    stroke-dasharray: 760;
    stroke-dashoffset: 760;
    animation: draw 2.4s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
    filter: drop-shadow(0 0 6px rgb(59 130 246 / 0.6));
  }
  .area {
    opacity: 0;
    animation: fade 1.2s ease 1.8s forwards;
  }
  .dot {
    fill: #05060b;
    stroke: #22d3ee;
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.4s ease forwards;
    animation-delay: calc(0.5s + var(--i) * 0.45s);
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-align: right;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      stroke-dashoffset: 0;
    }
    .area,
    .dot {
      opacity: 1;
    }
  }
</style>
