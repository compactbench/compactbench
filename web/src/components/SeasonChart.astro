---
// The homepage chart, drawn from the published results: score after each compaction for
// the best method and for the steadiest one near it, under the full-conversation ceiling.
// It redraws itself from the data whenever the leaderboard changes.
import { calibration, rows, season, seasonLabel } from "../lib/data";

const methods = rows.filter((r) => r.row_kind !== "control" && r.by_cycle.length > 1);
const best = [...methods].sort((a, b) => b.score - a.score)[0];
const drop = (r: (typeof methods)[number]) => Math.abs(r.by_cycle[0]! - r.by_cycle[r.by_cycle.length - 1]!);
// The steadiest method among those within 5 points of the best: the contrast that matters.
const steady = methods
  .filter((r) => best && r !== best && r.score >= best.score - 0.05)
  .sort((a, b) => drop(a) - drop(b))[0];
const ceilings = calibration ? Object.values(calibration.families).map((f) => f.ceiling) : [];
const ceiling = ceilings.length ? ceilings.reduce((a, b) => a + b, 0) / ceilings.length : null;

const W = 540, H = 320, L = 34, R = 200, T = 14, B = 46;
const n = best?.by_cycle.length ?? 5;
const x = (i: number) => L + ((W - L - R) * i) / (n - 1);
const y = (v: number) => T + (H - T - B) * (1 - v);
const path = (vals: number[]) => vals.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
const p = (v: number) => Math.round(v * 100);
const series = [
  best && { row: best, cls: "best", note: "best overall" },
  steady && { row: steady, cls: "steady", note: "steadiest" },
].filter(Boolean) as { row: NonNullable<typeof best>; cls: string; note: string }[];
// Keep end labels from colliding.
const ends = series.map((s) => y(s.row.by_cycle[n - 1]!));
if (ends.length === 2 && Math.abs(ends[0]! - ends[1]!) < 42) {
  const mid = (ends[0]! + ends[1]!) / 2;
  const up = ends[0]! < ends[1]! ? 0 : 1;
  ends[up] = mid - 21;
  ends[1 - up] = mid + 21;
}
const summary = series
  .map((s) => `${s.row.method_name}: ${s.row.by_cycle.map(p).join(", ")}`)
  .join("; ");
---

{
  best && (
    <figure class="season">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${seasonLabel(season.key)} score after each compaction. ${summary}.${ceiling ? ` Full conversation: ${p(ceiling)}.` : ""}`}>
        {[0, 0.25, 0.5, 0.75, 1].map((v) => (
          <g>
            <line x1={L} x2={W - R + 8} y1={y(v)} y2={y(v)} class="rule" />
            <text x={L - 10} y={y(v) + 4} class="axis" text-anchor="end">{p(v)}</text>
          </g>
        ))}
        {Array.from({ length: n }, (_, i) => (
          <text x={x(i)} y={H - B + 20} class="axis" text-anchor="middle">{i + 1}</text>
        ))}
        <text x={L} y={H - 6} class="axis title">after compaction</text>
        {ceiling && (
          <g>
            <line x1={L} x2={W - R + 8} y1={y(ceiling)} y2={y(ceiling)} class="ceiling" />
            <text x={W - R + 16} y={y(ceiling) + 4} class="label muted-label">full conversation {p(ceiling)}</text>
          </g>
        )}
        {series.map((s, k) => (
          <g class={s.cls}>
            <path d={path(s.row.by_cycle)} class="line" style={`--k:${k}`} />
            {s.row.by_cycle.map((v, i) => <circle cx={x(i)} cy={y(v)} r="4.5" class="dot" style={`--i:${i};--k:${k}`} />)}
            <text x={W - R + 16} y={ends[k]! - 2} class="label">{s.row.method_name}</text>
            <text x={W - R + 16} y={ends[k]! + 16} class="label sub">
              {p(s.row.by_cycle[0]!)} → {p(s.row.by_cycle[n - 1]!)} · {s.note}
            </text>
          </g>
        ))}
      </svg>
      <figcaption>
        {seasonLabel(season.key)}: how much of the conversation's state a fixed reader can still find after each
        compaction (0–100), with a {season.budget_tokens.toLocaleString("en-US")}-token memory.{" "}
        <a href="/leaderboard">All methods</a>
      </figcaption>
    </figure>
  )
}

<style>
  .season {
    margin: 0;
    padding: 16px 16px 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: linear-gradient(180deg, rgb(11 14 23 / 0.9), rgb(5 6 11 / 0.6));
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .rule {
    stroke: #161c2c;
    stroke-width: 1;
  }
  .axis {
    fill: var(--muted);
    font: 13px var(--mono);
  }
  .axis.title {
    font-size: 12.5px;
    letter-spacing: 0.04em;
  }
  .ceiling {
    stroke: #3a4560;
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }
  .label {
    font: 600 15px var(--font);
    fill: var(--text);
  }
  .label.sub,
  .muted-label {
    font: 12.5px var(--mono);
    fill: var(--muted);
  }
  .line {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    animation: draw 1.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(0.2s + var(--k) * 0.5s);
  }
  .best .line {
    stroke: #3b82f6;
  }
  .steady .line {
    stroke: #8b5cf6;
  }
  .best .label:not(.sub) {
    fill: #7cb0ff;
  }
  .steady .label:not(.sub) {
    fill: #b39cff;
  }
  .dot {
    fill: #05060b;
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.3s ease forwards;
    animation-delay: calc(0.3s + var(--k) * 0.5s + var(--i) * 0.3s);
  }
  .best .dot {
    stroke: #22d3ee;
  }
  .steady .dot {
    stroke: #8b5cf6;
  }
  figcaption {
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      stroke-dashoffset: 0;
      animation: none;
    }
    .dot {
      opacity: 1;
      animation: none;
    }
  }
</style>
